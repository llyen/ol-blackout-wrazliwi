        "dataSourceId": "b89bc721-f036-e371-1d1a-935f77e3af8c"
      },
      "text": "OutageEvents\n| where event_time between (_startTime .. _endTime)\n| summarize arg_max(event_time, status, customers_without_power, cascade_stage) by gmina_code\n| where status != 'restored'\n| join kind=inner (dim_gmina | project gmina_code, gmina_name, lat, lon) on gmina_code\n| project gmina_name, lat, lon, Odbiorcy = customers_without_power, Etap = cascade_stage, status",
      "id": "8a46ddc7-59ec-6ec0-bbfe-c7acf5760a67",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b89bc721-f036-e371-1d1a-935f77e3af8c"
      },
      "text": "let awarie = OutageEvents | where event_time between (_startTime .. _endTime)\n    | summarize arg_max(event_time, status, customers_without_power) by gmina_code\n    | where status != 'restored';\nlet zgloszenia = EmergencyCalls | where event_time between (_startTime .. _endTime);\nlet telco = TelecomCoverage | where event_time between (_startTime .. _endTime)\n    | summarize arg_max(event_time, coverage_pct) by gmina_code;\nlet punkty = HeatingPointStatus | where event_time between (_startTime .. _endTime)\n    | summarize arg_max(event_time, status, occupancy, capacity) by heating_point_id;\nlet agregaty = GeneratorDispatch | where event_time between (_startTime .. _endTime)\n    | summarize arg_max(event_time, status, power_kw) by dispatch_id;\nunion\n  (awarie     | summarize Wskaznik = 'Gminy bez pradu', Wartosc = dcount(gmina_code)),\n  (awarie     | summarize Wskaznik = 'Odbiorcy bez pradu', Wartosc = sum(customers_without_power)),\n  (zgloszenia | summarize Wskaznik = 'Zgloszenia 112', Wartosc = count()),\n  (zgloszenia | summarize Wskaznik = 'W tym priorytet P1', Wartosc = countif(priority == 'P1')),\n  (telco      | summarize Wskaznik = 'Gminy bez lacznosci', Wartosc = countif(coverage_pct < 0.2)),\n  (punkty     | summarize Wskaznik = 'Osoby w punktach grzewczych', Wartosc = sum(occupancy)),\n  (agregaty   | summarize Wskaznik = 'Agregaty w dyspozycji', Wartosc = count())",
      "id": "87f5204e-cadc-658c-6450-541aad3e7ea7",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b89bc721-f036-e371-1d1a-935f77e3af8c"
      },
      "text": "OutageEvents\n| where event_time between (_startTime .. _endTime)\n| summarize Odbiorcy = sum(customers_without_power), Gminy = dcount(gmina_code)\n    by Czas = bin(event_time, 1m), Etap = strcat('Etap ', tostring(cascade_stage))\n| order by Czas asc",
      "id": "cba8a48c-269d-b8f1-12ae-b37863c12f4a",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b89bc721-f036-e371-1d1a-935f77e3af8c"
      },
      "text": "OutageEvents\n| where event_time between (_startTime .. _endTime)\n| summarize arg_max(event_time, status, customers_without_power) by gmina_code\n| where status != 'restored'\n| join kind=inner (dim_gmina | project gmina_code, voivodeship_code) on gmina_code\n| summarize Odbiorcy = sum(customers_without_power), Gminy = dcount(gmina_code) by voivodeship_code\n| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code\n| project Wojewodztwo = voivodeship_name, Odbiorcy, Gminy\n| order by Odbiorcy desc",
      "id": "d49d111f-9197-046d-e7c8-0074fc1fb8de",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b89bc721-f036-e371-1d1a-935f77e3af8c"
      },
      "text": "let telco = TelecomCoverage | where event_time between (_startTime .. _endTime)\n    | summarize arg_max(event_time, coverage_pct) by gmina_code;\nOutageEvents\n| where event_time between (_startTime .. _endTime)\n| summarize Poczatek = min(event_time), arg_max(event_time, status, customers_without_power, root_cause, eta_restore_time) by gmina_code\n| where status != 'restored'\n| extend Godzin = round(todouble(datetime_diff('minute', event_time, Poczatek)) / 60.0, 1)\n| join kind=leftouter (telco) on gmina_code\n| join kind=inner (dim_gmina | project gmina_code, gmina_name, voivodeship_code) on gmina_code\n| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code\n| project Gmina = gmina_name, Wojewodztwo = voivodeship_name, Odbiorcy = customers_without_power,\n          Godzin, Lacznosc = round(coalesce(coverage_pct, 1.0) * 100, 0), Przyczyna = root_cause,\n          Przywrocenie = eta_restore_time\n| order by Odbiorcy desc\n| take 40",
      "id": "9a5f5e24-330c-bf10-6b35-ed039498e2c3",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b89bc721-f036-e371-1d1a-935f77e3af8c"
      },
      "text": "OutageEvents\n| where event_time between (_startTime .. _endTime)\n| summarize arg_max(event_time, status, customers_without_power) by gmina_code\n| where status != 'restored'\n| join kind=inner (PopulationVulnerability | project gmina_code, population, vulnerable_population_est, rescue_travel_time_min) on gmina_code\n| join kind=inner (dim_gmina | project gmina_code, gmina_name) on gmina_code\n| extend Udzial = todouble(customers_without_power) / todouble(max_of(population, 1))\n| extend Wrazliwi = tolong(vulnerable_population_est * min_of(Udzial, 1.0))\n| project Gmina = gmina_name, Wrazliwi, Odbiorcy = customers_without_power,\n          DojazdMin = rescue_travel_time_min, Populacja = population\n| order by Wrazliwi desc\n| take 40",
      "id": "72549711-8153-0ece-ae6b-c166036475f6",
      "usedVariables": [
