      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b89bc721-f036-e371-1d1a-935f77e3af8c"
      },
      "text": "OutageEvents\n| where event_time between (_startTime .. _endTime)\n| summarize arg_max(event_time, status, customers_without_power) by gmina_code\n| where status != 'restored'\n| join kind=inner (PopulationVulnerability | project gmina_code, population, vulnerable_population_est) on gmina_code\n| extend Wrazliwi = tolong(vulnerable_population_est * min_of(todouble(customers_without_power) / todouble(max_of(population, 1)), 1.0))\n| join kind=inner (dim_gmina | project gmina_code, voivodeship_code) on gmina_code\n| summarize Wrazliwi = sum(Wrazliwi) by voivodeship_code\n| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code\n| project Wojewodztwo = voivodeship_name, Wrazliwi\n| order by Wrazliwi desc",
      "id": "b63c1280-9401-67fb-0bd0-be34fdeb76c7",
      "usedVariables": [
