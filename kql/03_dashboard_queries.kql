// 03_dashboard_queries.kql - kafelki Real-Time Dashboard scenariusza „Tarcza Zimowa".
//
// Format naglowka jest kontraktem dla deploy\create_dashboard.ps1: numer, tytul i strona.
// Zmienne _startTime i _endTime pochodza z parametru zakresu czasu dashboardu; kafelek
// bez nich pokazuje stan biezacy niezaleznie od ustawionego okna.
//
// Zasada wydajnosci: najpierw filtr czasu, potem agregacja, na koncu join z wymiarem.
// Ma to tu wieksze znaczenie niz w innych scenariuszach, bo TelecomCoverage i
// WeatherReadings licza setki tysiecy wierszy, a wymiary najwyzej kilka tysiecy.

// 01. Kafelek: „Gminy bez zasilania” | Strona: Obraz sytuacji
OutageEvents
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, status, customers_without_power, cascade_stage) by gmina_code
| where status != 'restored'
| join kind=inner (dim_gmina | project gmina_code, gmina_name, lat, lon) on gmina_code
| project gmina_name, lat, lon, Odbiorcy = customers_without_power, Etap = cascade_stage, status

// 02. Kafelek: „Puls sytuacji kryzysowej” | Strona: Obraz sytuacji
let awarie = OutageEvents | where event_time between (_startTime .. _endTime)
    | summarize arg_max(event_time, status, customers_without_power) by gmina_code
    | where status != 'restored';
let zgloszenia = EmergencyCalls | where event_time between (_startTime .. _endTime);
let telco = TelecomCoverage | where event_time between (_startTime .. _endTime)
    | summarize arg_max(event_time, coverage_pct) by gmina_code;
let punkty = HeatingPointStatus | where event_time between (_startTime .. _endTime)
    | summarize arg_max(event_time, status, occupancy, capacity) by heating_point_id;
let agregaty = GeneratorDispatch | where event_time between (_startTime .. _endTime)
    | summarize arg_max(event_time, status, power_kw) by dispatch_id;
union
  (awarie     | summarize Wskaznik = 'Gminy bez pradu', Wartosc = dcount(gmina_code)),
  (awarie     | summarize Wskaznik = 'Odbiorcy bez pradu', Wartosc = sum(customers_without_power)),
  (zgloszenia | summarize Wskaznik = 'Zgloszenia 112', Wartosc = count()),
  (zgloszenia | summarize Wskaznik = 'W tym priorytet P1', Wartosc = countif(priority == 'P1')),
  (telco      | summarize Wskaznik = 'Gminy bez lacznosci', Wartosc = countif(coverage_pct < 0.2)),
  (punkty     | summarize Wskaznik = 'Osoby w punktach grzewczych', Wartosc = sum(occupancy)),
  (agregaty   | summarize Wskaznik = 'Agregaty w dyspozycji', Wartosc = count())

// 03. Kafelek: „Rozwoj kaskady awarii” | Strona: Obraz sytuacji
OutageEvents
| where event_time between (_startTime .. _endTime)
| summarize Odbiorcy = sum(customers_without_power), Gminy = dcount(gmina_code)
    by Czas = bin(event_time, 1m), Etap = strcat('Etap ', tostring(cascade_stage))
| order by Czas asc

// 04. Kafelek: „Skala awarii wedlug wojewodztw” | Strona: Obraz sytuacji
OutageEvents
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, status, customers_without_power) by gmina_code
| where status != 'restored'
| join kind=inner (dim_gmina | project gmina_code, voivodeship_code) on gmina_code
| summarize Odbiorcy = sum(customers_without_power), Gminy = dcount(gmina_code) by voivodeship_code
| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code
| project Wojewodztwo = voivodeship_name, Odbiorcy, Gminy
| order by Odbiorcy desc

// 05. Kafelek: „Gminy wymagajace decyzji” | Strona: Obraz sytuacji
let telco = TelecomCoverage | where event_time between (_startTime .. _endTime)
    | summarize arg_max(event_time, coverage_pct) by gmina_code;
OutageEvents
| where event_time between (_startTime .. _endTime)
| summarize Poczatek = min(event_time), arg_max(event_time, status, customers_without_power, root_cause, eta_restore_time) by gmina_code
| where status != 'restored'
| extend Godzin = round(todouble(datetime_diff('minute', event_time, Poczatek)) / 60.0, 1)
| join kind=leftouter (telco) on gmina_code
| join kind=inner (dim_gmina | project gmina_code, gmina_name, voivodeship_code) on gmina_code
| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code
| project Gmina = gmina_name, Wojewodztwo = voivodeship_name, Odbiorcy = customers_without_power,
          Godzin, Lacznosc = round(coalesce(coverage_pct, 1.0) * 100, 0), Przyczyna = root_cause,
          Przywrocenie = eta_restore_time
| order by Odbiorcy desc
| take 40

// 06. Kafelek: „Ludnosc wrazliwa w gminach bez zasilania” | Strona: Ludnosc wrazliwa
OutageEvents
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, status, customers_without_power) by gmina_code
| where status != 'restored'
| join kind=inner (PopulationVulnerability | project gmina_code, population, vulnerable_population_est, rescue_travel_time_min) on gmina_code
| join kind=inner (dim_gmina | project gmina_code, gmina_name) on gmina_code
| extend Udzial = todouble(customers_without_power) / todouble(max_of(population, 1))
| extend Wrazliwi = tolong(vulnerable_population_est * min_of(Udzial, 1.0))
| project Gmina = gmina_name, Wrazliwi, Odbiorcy = customers_without_power,
          DojazdMin = rescue_travel_time_min, Populacja = population
| order by Wrazliwi desc
| take 40

// 07. Kafelek: „Osoby wrazliwe bez zasilania wedlug wojewodztw” | Strona: Ludnosc wrazliwa
OutageEvents
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, status, customers_without_power) by gmina_code
| where status != 'restored'
| join kind=inner (PopulationVulnerability | project gmina_code, population, vulnerable_population_est) on gmina_code
| extend Wrazliwi = tolong(vulnerable_population_est * min_of(todouble(customers_without_power) / todouble(max_of(population, 1)), 1.0))
| join kind=inner (dim_gmina | project gmina_code, voivodeship_code) on gmina_code
| summarize Wrazliwi = sum(Wrazliwi) by voivodeship_code
| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code
| project Wojewodztwo = voivodeship_name, Wrazliwi
| order by Wrazliwi desc

// 08. Kafelek: „Struktura osob priorytetowych” | Strona: Ludnosc wrazliwa
PriorityPersons
| summarize Osoby = count() by Kategoria = category
| order by Osoby desc

// 09. Kafelek: „Zgloszenia 112 wedlug rodzaju” | Strona: Ludnosc wrazliwa
EmergencyCalls
| where event_time between (_startTime .. _endTime)
| summarize Zgloszenia = count() by Czas = bin(event_time, 1m), Rodzaj = call_type
| order by Czas asc

// 10. Kafelek: „Osoby priorytetowe w gminach odcietych” | Strona: Ludnosc wrazliwa
let bezPradu = OutageEvents | where event_time between (_startTime .. _endTime)
    | summarize arg_max(event_time, status) by gmina_code | where status != 'restored' | project gmina_code;
let telco = TelecomCoverage | where event_time between (_startTime .. _endTime)
    | summarize arg_max(event_time, coverage_pct) by gmina_code;
PriorityPersons
| where category in ('dialysis', 'home_oxygen', 'powered_medical_device')
| join kind=inner (bezPradu) on gmina_code
| join kind=leftouter (telco) on gmina_code
| join kind=inner (dim_gmina | project gmina_code, gmina_name) on gmina_code
| project Osoba = person_token, Kategoria = category, Gmina = gmina_name,
          AutonomiaH = medical_device_autonomy_hours,
          Lacznosc = round(coalesce(coverage_pct, 1.0) * 100, 0), Samotnie = is_living_alone
| order by AutonomiaH asc
| take 40

// 11. Kafelek: „Punkty grzewcze w terenie” | Strona: Cieplo i opieka
HeatingPointStatus
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, status, occupancy, capacity, needs_generator, needs_medical_support) by heating_point_id
| join kind=inner (HeatingPoints | project heating_point_id, heating_point_type, lat, lon) on heating_point_id
| extend Zapelnienie = round(todouble(occupancy) * 100.0 / todouble(max_of(capacity, 1)), 0)
| project heating_point_id, lat, lon, Zapelnienie, Osoby = occupancy, Typ = heating_point_type, status

// 12. Kafelek: „Zapelnienie punktow grzewczych” | Strona: Cieplo i opieka
HeatingPointStatus
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, occupancy, capacity, gmina_code) by heating_point_id
| extend Zapelnienie = round(todouble(occupancy) * 100.0 / todouble(max_of(capacity, 1)), 0)
| join kind=inner (dim_gmina | project gmina_code, gmina_name) on gmina_code
| project Punkt = strcat(gmina_name, ' / ', heating_point_id), Zapelnienie, Osoby = occupancy
| order by Zapelnienie desc
| take 20

// 13. Kafelek: „Placowki opieki wymagajace zasilania” | Strona: Cieplo i opieka
CareFacilityAutonomyState()
| where recommended_action != 'monitor'
| join kind=inner (dim_gmina | project gmina_code, gmina_name) on gmina_code
| project Placowka = facility_id, Typ = facility_type, Gmina = gmina_name,
          Podopieczni = current_occupancy, AutonomiaH = generator_autonomy_hours,
          MocKW = power_need_kw, Rekomendacja = recommended_action
| order by Podopieczni desc
| take 40

// 14. Kafelek: „Agregaty wedlug stanu dysponowania” | Strona: Cieplo i opieka
GeneratorDispatch
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, status, power_kw, target_type) by dispatch_id
| summarize Agregaty = count(), MocKW = sum(power_kw) by Stan = status, Cel = target_type
| order by Agregaty desc

// 15. Kafelek: „Rozdysponowana moc w czasie” | Strona: Cieplo i opieka
GeneratorDispatch
| where event_time between (_startTime .. _endTime)
| summarize MocKW = sum(power_kw), Dyspozycje = count() by Czas = bin(event_time, 1m)
| order by Czas asc

// 16. Kafelek: „Gminy bez lacznosci” | Strona: Lacznosc i ostrzeganie
TelecomCoverage
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, coverage_pct, bts_total, bts_on_battery, battery_hours_remaining) by gmina_code
| where coverage_pct < 0.6
| join kind=inner (dim_gmina | project gmina_code, gmina_name, lat, lon) on gmina_code
| project gmina_name, lat, lon, Pokrycie = round(coverage_pct * 100, 0),
          BTSnaBaterii = bts_on_battery, ZapasH = round(battery_hours_remaining, 1)

// 17. Kafelek: „Pokrycie telekomunikacyjne w czasie” | Strona: Lacznosc i ostrzeganie
TelecomCoverage
| where event_time between (_startTime .. _endTime)
| summarize SrednePokrycie = round(avg(coverage_pct) * 100, 1),
            GminyPonizej20 = countif(coverage_pct < 0.2),
            GminyPonizej60 = countif(coverage_pct < 0.6)
    by Czas = bin(event_time, 1m)
| order by Czas asc

// 18. Kafelek: „Skutecznosc kanalow ostrzegania SPO-3” | Strona: Lacznosc i ostrzeganie
// Bez filtru czasu: ostrzeganie SPO-3 poprzedza kaskade, wiec w ruchomym oknie live
// tych zdarzen juz nie ma. Kafelek pokazuje bilans calej akcji ostrzegawczej.
AlertDelivery
| summarize Wyslane = sum(messages_sent), Dostarczone = sum(messages_delivered), Otwarte = sum(messages_opened) by Kanal = channel
| extend Dostarczalnosc = round(todouble(Dostarczone) * 100.0 / todouble(max_of(Wyslane, 1)), 1)
| project Kanal, Dostarczalnosc, Wyslane, Dostarczone, Otwarte
| order by Dostarczalnosc desc

// 19. Kafelek: „Gminy o najnizszej dostarczalnosci ostrzezen” | Strona: Lacznosc i ostrzeganie
AlertDelivery
| summarize Wyslane = sum(messages_sent), Dostarczone = sum(messages_delivered) by gmina_code
| where Wyslane > 0
| extend Dostarczalnosc = round(todouble(Dostarczone) * 100.0 / todouble(Wyslane), 1)
| join kind=inner (dim_gmina | project gmina_code, gmina_name, population) on gmina_code
| project Gmina = gmina_name, Dostarczalnosc, Wyslane, Dostarczone, Mieszkancy = population
| order by Dostarczalnosc asc
| take 30

// 20. Kafelek: „Temperatura odczuwalna w powiatach” | Strona: Pogoda i prognoza
WeatherReadings
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, feels_like_c, temperature_c, wind_kmh, icing_index) by powiat_code
| join kind=inner (dim_powiat | project powiat_code, powiat_name, lat, lon) on powiat_code
| project powiat_name, lat, lon, Odczuwalna = feels_like_c, Temperatura = temperature_c,
          Wiatr = wind_kmh, Oblodzenie = icing_index

// 21. Kafelek: „Przebieg warunkow pogodowych” | Strona: Pogoda i prognoza
WeatherReadings
| where event_time between (_startTime .. _endTime)
| summarize Odczuwalna = round(avg(feels_like_c), 1), Temperatura = round(avg(temperature_c), 1),
            Wiatr = round(avg(wind_kmh), 1)
    by Czas = bin(event_time, 1m)
| order by Czas asc

// 22. Kafelek: „Powiaty o najostrzejszych warunkach” | Strona: Pogoda i prognoza
WeatherReadings
| where event_time between (_startTime .. _endTime)
| summarize arg_max(event_time, feels_like_c, wind_kmh, snow_cm_30m, icing_index) by powiat_code
| join kind=inner (dim_powiat | project powiat_code, powiat_name, voivodeship_code) on powiat_code
| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code
| project Powiat = powiat_name, Wojewodztwo = voivodeship_name, Odczuwalna = feels_like_c,
          Wiatr = wind_kmh, SniegCm = snow_cm_30m, Oblodzenie = icing_index
| order by Odczuwalna asc
| take 30
